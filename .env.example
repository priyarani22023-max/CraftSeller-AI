# GEMINI_API_KEY: Credential used by Google AI Studio endpoint to access Google models.
# Note: In CraftSeller AI, this authenticates the open-weight Gemma model, NOT Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL: The configured Gemma open-weight model ID.
# Preferred model: gemma-4-26b-a4b-it (Google Gemma 4 26B A4B IT)
# Alternate tested models: gemma-4-31b-it
GEMMA_MODEL="gemma-4-26b-a4b-it"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
